{
  "name": "manuscript-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Review AI-suggested copyedits to novel chapters, one change at a time.",
  "license": "MIT",
  "author": {
    "name": "Michael Bradet-Legris",
    "email": "45394569+MichaelBradetLegris@users.noreply.github.com"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "node scripts/dev-clean.cjs",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --build --force",
    "prepackage": "node scripts/sync-branding.cjs",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "branding:check": "node scripts/sync-branding.cjs --check",
    "check:public": "node scripts/check-public.ts",
    "icons": "python scripts/make-icons.py",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "diff": "9.0.0",
    "diff-match-patch": "1.0.5",
    "openai": "^7.15.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  },
  "productName": "Lapidary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBradetLegris/lapidary.git"
  },
  "homepage": "https://github.com/MichaelBradetLegris/lapidary#readme",
  "bugs": {
    "url": "https://github.com/MichaelBradetLegris/lapidary/issues"
  }
}
