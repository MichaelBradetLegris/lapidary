{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "node_modules/.tmp/types-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/state/store.ts",
    "src/renderer/state/models.ts",
    "src/renderer/state/persist.ts",
    "src/renderer/state/saveChapter.ts",
    "src/renderer/state/drafts.ts",
    "src/renderer/state/leave.ts",
    "src/renderer/state/reviewStart.ts",
    "src/renderer/state/closeGuard.ts",
    "src/renderer/state/hints.ts",
    "src/renderer/state/split.ts",
    "src/renderer/state/welcome.ts",
    "src/renderer/state/hover.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.slow.config.ts"
  ],
  "exclude": ["test/**/*.render.test.ts"]
}
